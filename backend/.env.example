# DineMate backend configuration
#
# >>> PASTE YOUR DEEPSEEK KEY ON THE NEXT LINE <<<
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Local infrastructure (docker compose up)
POSTGRES_URL=postgresql+asyncpg://dinemate:dinemate@localhost:5433/dinemate
MONGODB_URL=mongodb://localhost:27018
MONGODB_DB=dinemate

# Liveness-check every pooled connection before use. Worth it when the database
# suspends when idle (Neon), and a round trip of pure cost when it does not.
# See docs/DEPLOYMENT.md, "Latency".
PG_POOL_PRE_PING=true

# Auth
JWT_SECRET=generate-with-openssl-rand-base64-48
COOKIE_SECURE=false

# Domain
TAX_RATE=0.08
CANCELLATION_WINDOW_MINUTES=10

# API
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
INTERNAL_SECRET=change-me
